    {
      "@type": "FAQPage",
      "@id": "https://loobdesign.com/#loob-faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Loob Design?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Loob Design (often shortened to Loob, spelled L-O-O-B) is a software company based in Sunderland, United Kingdom and Accra, Ghana. Loob Design builds custom software, websites, mobile apps, ERP systems, Salesforce platforms, and startup MVPs for clients in Ghana, the UK (including London), the United States, and worldwide. Official site: https://loobdesign.com"
          }
        },
        {
          "@type": "Question",
          "name": "Is Loob Design the same as Loop Design?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Loob Design is a different company. The brand is spelled Loob (L-O-O-B), not Loop. Loob Design is a software company and is not affiliated with Loop Design Awards, Loop Design architecture firms, or other Loop Design entities."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Loob Design located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Loob Design has offices in Sunderland, United Kingdom (A690, SR1 1AE) and Accra, Ghana. Contact: +44 7307 246096 (UK), 020 258 5094 (Ghana), hello@loobdesign.com."
          }
        },
        {
          "@type": "Question",
          "name": "What does Loob Design do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Loob Design provides software development, web development, mobile app development, website design, startup MVP builds, ERP software, Salesforce platform solutions, and productivity software."
          }
        }
      ]
